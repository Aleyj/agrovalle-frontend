# Local: copiar a .env.local. En Vercel configurar VITE_API_URL y recompilar.
# Solo URL publica; ninguna clave del backend debe llevar el prefijo VITE_.
VITE_API_URL=http://localhost:3000
# URL base del servicio Streamlit, sin tokens, contrasenas ni parametros.
# En desarrollo se usa http://localhost:8501 si no se define esta variable.
VITE_STREAMLIT_URL=
